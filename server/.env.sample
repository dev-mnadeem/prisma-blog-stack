# Copy to .env before running the API.
PORT=7231
NODE_ENV=development

# docker compose provides this database; change host/port for a native Postgres.
DATABASE_URL="postgresql://blogs:blogs@localhost:7233/blogs"

# Required. Any long random string — `openssl rand -hex 32` produces one.
JWT_SECRET="change-me-before-you-deploy-anything"
JWT_TTL_SECONDS=43200

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS="http://localhost:7232"

# Excerpt generation. "local" is deterministic and needs no network or key.
# "anthropic" calls Claude and falls back to "local" on any failure.
SUMMARY_PROVIDER=local
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5
