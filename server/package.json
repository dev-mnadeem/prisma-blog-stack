{
  "name": "@blogs/server",
  "version": "1.0.0",
  "private": true,
  "description": "Express + Prisma API behind the blog: accounts, posts, excerpts and search.",
  "license": "MIT",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "dev": "nodemon --watch src --ext ts --exec \"ts-node src/server.ts\"",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "seed": "ts-node prisma/seed.ts",
    "lint": "eslint src tests prisma",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write \"{src,tests,prisma}/**/*.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "mocha \"tests/unit/**/*.test.ts\"",
    "test:api": "mocha --timeout 20000 \"tests/api/**/*.test.ts\"",
    "test": "npm run test:unit && npm run test:api"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.137.0",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "yup": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/chai": "^5.2.3",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/mocha": "^10.0.10",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "chai": "^6.3.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "mocha": "^12.0.3",
    "nodemon": "^3.1.14",
    "prettier": "^3.4.2",
    "prisma": "^6.19.3",
    "supertest": "^7.3.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.72.1"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  }
}
